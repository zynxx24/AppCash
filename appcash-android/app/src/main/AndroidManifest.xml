<?xml version="1.0" encoding="utf-8"?>
<!-- » Deklarasi versi XML dan penyandian huruf UTF-8. Ini file XML. -->
<!-- » <manifest> = "KTP aplikasi": daftar identitas, izin, dan layar yang dimiliki AppCash. xmlns:android = -->
<!-- » alamat kamus istilah Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- » Izin INTERNET: aplikasi boleh memakai internet (dibutuhkan untuk membuka WhatsApp/tautan; data kas -->
    <!-- » sendiri tersimpan offline). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- » Izin membaca status jaringan (ACCESS_NETWORK_STATE). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- » <application> = pengaturan seluruh aplikasi. -->
    <!-- » android:name : Kelas induk aplikasi: AppCashApplication (yang membuat repository). -->
    <!-- » android:allowBackup : Boleh dicadangkan otomatis oleh Android (allowBackup). -->
    <!-- » android:icon : Ikon aplikasi di layar HP. -->
    <!-- » android:label : Nama aplikasi yang tampil di bawah ikon (diambil dari strings.xml: "AppCash"). -->
    <!-- » android:roundIcon : Ikon versi bulat (untuk HP yang memakai ikon bulat). -->
    <!-- » android:supportsRtl : Mendukung tulisan kanan-ke-kiri (RTL) bila bahasa HP memerlukan. -->
    <!-- » android:theme : Tema dasar aplikasi: Theme.AppCash (dibuat di themes.xml). -->
    <!-- » android:usesCleartextTraffic : Mengizinkan sambungan http biasa (tanpa https). -->
    <application
        android:name=".AppCashApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCash"
        android:usesCleartextTraffic="true">
        <!-- » <activity> = satu layar yang terdaftar. -->
        <!-- » android:name : Layar yang dibuka adalah kelas ui.MainActivity. -->
        <!-- » android:exported : exported = true: layar boleh dibuka dari luar (wajib agar ikon launcher bisa -->
        <!-- » membukanya). -->
        <!-- » android:theme : Tema layar ini juga Theme.AppCash. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCash">
            <!-- » <intent-filter> = aturan kapan layar ini dibuka. -->
            <intent-filter>
                <!-- » Aksi MAIN = titik masuk utama aplikasi. -->
                <action android:name="android.intent.action.MAIN" />
                <!-- » Kategori LAUNCHER = muncul sebagai ikon di daftar aplikasi HP. -->
                <category android:name="android.intent.category.LAUNCHER" />
            <!-- » Tutup aturan. -->
            </intent-filter>
        <!-- » Tutup layar MainActivity. -->
        </activity>
    <!-- » Tutup application. -->
    </application>

<!-- » Tutup manifest. -->
</manifest>
